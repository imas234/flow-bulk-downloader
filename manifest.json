{
  "manifest_version": 3,
  "name": "Flow Image Bulk Downloader",
  "version": "0.3.0",
  "description": "Wizard-based side panel to scan Google Flow projects and bulk download or delete generated images.",
  "incognito": "split",
  "permissions": ["activeTab", "scripting", "downloads", "sidePanel", "tabs", "storage"],
  "host_permissions": ["https://*.google.com/*", "https://*.googleusercontent.com/*"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Flow Image Bulk Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/tools/flow/project/*"],
      "js": [
        "content/constants.js",
        "content/dom.js",
        "content/zip.js",
        "content/scan.js",
        "content/download.js",
        "content/delete.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
